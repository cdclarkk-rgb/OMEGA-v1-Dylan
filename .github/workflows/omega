# HURST EXPONENT VOLATILITY METRICS (preserved)
# ============================================================
def hurst_exponent(ts, lags=20):
    ts = np.asarray(ts)
    if len(ts) < lags + 1:
        return 0.5
    lags = np.arange(2, lags + 1)
    tau = [np.std(np.diff(ts, lag)) for lag in lags]
    m = np.polyfit(np.log(lags), np.log(tau), 1)
    return m[0]

